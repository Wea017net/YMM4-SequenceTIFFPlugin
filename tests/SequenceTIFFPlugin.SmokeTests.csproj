<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SequenceTIFFPlugin.SmokeTests</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SequenceFileResolver.cs" Link="SequenceFileResolver.cs" />
    <Compile Include="..\SequenceFrameMapper.cs" Link="SequenceFrameMapper.cs" />
    <Compile Include="..\SequenceTimelineMath.cs" Link="SequenceTimelineMath.cs" />
    <None Include="..\Localization\Resource.*.resx"
          Link="Localization\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
